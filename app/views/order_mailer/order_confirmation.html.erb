<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  </head>
  <body>
    <h1>ご注文ありがとうございます</h1>
    <p>注文番号: #<%= @order.id %></p>
    <h2>ご注文内容</h2>
    <table border="1" cellpadding="10" cellspacing="0">
      <thead>
        <tr>
          <th>商品名</th>
          <th>単価</th>
          <th>数量</th>
          <th>小計</th>
        </tr>
      </thead>
      <tbody>
        <% @order.order_items.each do |item| %>
          <tr>
            <td><%= item.product_name %></td>
            <td>¥<%= number_with_delimiter(item.price_at_purchase) %></td>
            <td><%= item.quantity %></td>
            <td>¥<%= number_with_delimiter(item.price_at_purchase * item.quantity) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <th colspan="3">合計</th>
          <th>¥<%= number_with_delimiter(@order.total_price) %></th>
        </tr>
      </tfoot>
    </table>
    <h2>お届け先</h2>
    <p>
      <%= @order.last_name %> <%= @order.first_name %><br>
      <%= @order.address %><br>
      <% if @order.address2? %>
        <%= @order.address2 %><br>
      <% end %>
      <%= @order.country %> <%= @order.state %> <%= @order.zip %>
    </p>
  </body>
</html>
