<div class="container mt-4">
  <h1>購入明細詳細</h1>
  <div class="row">
    <div class="col-md-8">
      <h2>注文情報</h2>
      <table class="table">
        <tr>
          <th>注文番号</th>
          <td>#<%= @order.id %></td>
        </tr>
        <tr>
          <th>注文日時</th>
          <td><%= @order.created_at.strftime('%Y年%m月%d日 %H:%M:%S') %></td>
        </tr>
        <tr>
          <th>合計金額</th>
          <td>¥<%= number_with_delimiter(@order.total_price) %></td>
        </tr>
      </table>
      <h2>お届け先</h2>
      <p>
        <%= @order.last_name %> <%= @order.first_name %><br>
        <%= @order.address %><br>
        <% if @order.address2.present? %>
          <%= @order.address2 %><br>
        <% end %>
        <%= @order.country %> <%= @order.state %> <%= @order.zip %>
      </p>
      <% if @order.email.present? %>
        <p>メールアドレス: <%= @order.email %></p>
      <% end %>
      <h2>ご注文内容</h2>
      <table class="table table-striped">
        <thead>
          <tr>
            <th>商品名</th>
            <th>単価</th>
            <th>数量</th>
            <th>小計</th>
          </tr>
        </thead>
        <tbody>
          <% @order.order_items.each do |item| %>
            <tr>
              <td><%= item.product_name %></td>
              <td>¥<%= number_with_delimiter(item.price_at_purchase) %></td>
              <td><%= item.quantity %></td>
              <td>¥<%= number_with_delimiter(item.price_at_purchase * item.quantity) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <th colspan="3">合計</th>
            <th>¥<%= number_with_delimiter(@order.total_price) %></th>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
  <%= link_to "一覧に戻る", admin_orders_path, class: "btn btn-secondary" %>
</div>
