<div class="container mt-4">
  <h1>購入明細一覧</h1>

  <table class="table table-striped">
    <thead>
      <tr>
        <th>注文番号</th>
        <th>お客様名</th>
        <th>合計金額</th>
        <th>注文日時</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% if @orders.empty? %>
        <tr>
          <td colspan="5" class="text-center">購入明細がありません</td>
        </tr>
      <% else %>
        <% @orders.each do |order| %>
          <tr>
            <td>#<%= order.id %></td>
            <td><%= order.last_name %> <%= order.first_name %></td>
            <td>¥<%= number_with_delimiter(order.total_price) %></td>
            <td><%= order.created_at.strftime('%Y年%m月%d日 %H:%M') %></td>
            <td><%= link_to "詳細", admin_order_path(order), class: "btn btn-sm btn-outline-primary" %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
