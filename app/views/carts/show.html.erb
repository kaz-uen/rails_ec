<div class="container">
  <div class="row px-4 px-lg-5 mt-5 mb-5">
    <div class="col-md-4 order-md-2 mb-4">
      <h4 class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-muted">カート</span>
        <span class="badge bg-secondary rounded-pill"><%= @cart_items.sum { |item| item[:quantity] } %></span>
      </h4>
      <ul class="list-group mb-3">
        <% if @cart_items.empty? %>
          <li class="list-group-item d-flex justify-content-between">
            <span>カートは空です</span>
          </li>
        <% else %>
          <% @cart_items.each do |item| %>
            <li class="list-group-item d-flex justify-content-between lh-sm">
              <div>
                <h6 class="my-0"><%= item[:product].name %></h6>
                <small class="text-muted">数量: <%= item[:quantity] %></small>
              </div>
              <div class="d-flex align-items-center">
                <span class="text-muted me-3">¥<%= number_with_delimiter(item[:product].price * item[:quantity]) %></span>
                <%= link_to "削除", cart_item_path(item[:product].id),
                  method: :delete,
                  data: { turbo_method: :delete, turbo_confirm: "カートから削除しますか？" },
                  class: "btn btn-sm btn-outline-danger" %>
              </div>
            </li>
          <% end %>
          <li class="list-group-item d-flex justify-content-between">
            <span>小計</span>
            <strong>¥<%= number_with_delimiter(@cart_total) %></strong>
          </li>
          <% if @promotion_code %>
            <li class="list-group-item d-flex justify-content-between text-success">
              <span>割引</span>
              <strong>-¥<%= number_with_delimiter(@promotion_code.discount_amount) %></strong>
            </li>
          <% end %>
          <li class="list-group-item d-flex justify-content-between">
            <span>合計</span>
            <strong>¥<%= number_with_delimiter(@cart_total - (@promotion_code&.discount_amount || 0)) %></strong>
          </li>
        <% end %>
      </ul>
      <%= form_with url: apply_promotion_code_cart_path, method: :post, local: true, class: "card p-2" do |form| %>
        <div class="input-group">
          <%= form.text_field :promotion_code, class: "form-control", placeholder: "プロモーションコード", value: @promotion_code&.code %>
          <%= form.submit "適用", class: "btn btn-secondary" %>
        </div>
        <% if @promotion_code %>
          <div class="mt-2 text-success">
            <small>割引額: ¥<%= number_with_delimiter(@promotion_code.discount_amount) %></small>
          </div>
        <% end %>
      <% end %>
    </div>
    <div class="col-md-8 order-md-1">
      <%= form_with model: @order || Order.new, url: checkouts_path, local: true, class: "needs-validation", novalidate: true do |form| %>
        <h4 class="mb-3">請求先住所</h4>
        <div class="row">
          <div class="col-md-6 mb-3">
            <%= form.label :first_name, "姓" %>
            <%= form.text_field :first_name, class: "form-control", id: "firstName", required: true %>
            <div class="invalid-feedback">
              有効な姓を入力してください。
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <%= form.label :last_name, "名" %>
            <%= form.text_field :last_name, class: "form-control", id: "lastName", required: true %>
            <div class="invalid-feedback">
              有効な名前を入力してください。
            </div>
          </div>
        </div>
        <div class="mb-3">
          <%= form.label :username, "ユーザー名" %>
          <div class="input-group">
            <span class="input-group-text">@</span>
            <%= form.text_field :username, class: "form-control", id: "username", placeholder: "Username", required: true %>
            <div class="invalid-feedback" style="width: 100%;">
              ユーザー名は必須です。
            </div>
          </div>
        </div>
        <div class="mb-3">
          <%= form.label :email, "メールアドレス" %>
          <span class="text-muted">(任意)</span>
          <%= form.email_field :email, class: "form-control", id: "email", placeholder: "you@example.com" %>
          <div class="invalid-feedback">
            有効なメールアドレスを入力してください。
          </div>
        </div>
        <div class="mb-3">
          <%= form.label :address, "住所" %>
          <%= form.text_field :address, class: "form-control", id: "address", placeholder: "例：東京都港区○○", required: true %>
          <div class="invalid-feedback">
            有効な配送先住所を入力してください。
          </div>
        </div>
        <div class="mb-3">
          <%= form.label :address2, "住所2" %>
          <span class="text-muted">(任意)</span>
          <%= form.text_field :address2, class: "form-control", id: "address2", placeholder: "例：○○マンション" %>
        </div>
        <div class="row">
          <div class="col-md-5 mb-3">
            <%= form.label :country, "国" %>
            <%= form.select :country, [["アメリカ", "アメリカ"]], { prompt: "選択する" }, { class: "form-select", id: "country", required: true } %>
            <div class="invalid-feedback">
              有効な国を選択してください。
            </div>
          </div>
          <div class="col-md-4 mb-3">
            <%= form.label :state, "州" %>
            <%= form.select :state, [["カリフォルニア", "カリフォルニア"], ["ニューヨーク", "ニューヨーク"]], { prompt: "選択する" }, { class: "form-select", id: "state", required: true } %>
            <div class="invalid-feedback">
              有効な州を入力してください。
            </div>
          </div>
          <div class="col-md-3 mb-3">
            <%= form.label :zip, "郵便番号" %>
            <%= form.text_field :zip, class: "form-control", id: "zip", placeholder: "ハイフンなし", required: true %>
            <div class="invalid-feedback">
              郵便番号は必須です。
            </div>
          </div>
        </div>
        <hr class="mb-4">
        <div class="form-check mb-2">
          <%= form.check_box :same_address, { id: "same-address", class: "form-check-input" }, "1", "0" %>
          <%= form.label :same_address, "配送先住所は請求先住所と同じです", class: "form-check-label", for: "same-address" %>
        </div>
        <div class="form-check mb-2">
          <%= form.check_box :save_info, { id: "save-info", class: "form-check-input" }, "1", "0" %>
          <%= form.label :save_info, "次回のためにこの情報を保存する", class: "form-check-label", for: "save-info" %>
        </div>
        <hr class="mb-4">
        <h4 class="mb-3">支払い方法（クレジットカード）</h4>
        <div class="row">
          <div class="col-md-6 mb-3">
            <%= form.label :card_name, "カード名義人" %>
            <%= form.text_field :card_name, class: "form-control", id: "cc-name", placeholder: "", required: true %>
            <small class="text-muted">カードに記載されている氏名</small>
            <div class="invalid-feedback">
              カード名義人は必須です
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <%= form.label :card_number, "クレジットカード番号" %>
            <%= form.text_field :card_number, class: "form-control", id: "cc-number", placeholder: "", required: true %>
            <div class="invalid-feedback">
              クレジットカード番号は必須です
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-md-3 mb-3">
            <%= form.label :card_exp, "有効期限" %>
            <%= form.text_field :card_exp, class: "form-control", id: "cc-expiration", placeholder: "MM/YY", required: true %>
            <div class="invalid-feedback">
              有効期限は必須です
            </div>
          </div>
          <div class="col-md-3 mb-3">
            <%= form.label :card_cvv, "セキュリティコード" %>
            <%= form.text_field :card_cvv, class: "form-control", id: "cc-cvv", placeholder: "", required: true %>
            <div class="invalid-feedback">
              セキュリティコードは必須です
            </div>
          </div>
        </div>
        <hr class="mb-4">
        <%= form.submit "購入する", class: "btn btn-primary btn-lg btn-block w-100" %>
      <% end %>
    </div>
  </div>
</div>
